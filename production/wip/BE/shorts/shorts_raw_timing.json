 "duration": 42.323,
 "paras": [
  {
   "start": 0.0,
   "end": 6.104,
   "sents": [
    {
     "start": 0.0,
     "end": 6.104,
     "text": "블룸 에너지, 최고 실적 한 달 뒤 주가는 최고가보다 오십팔 점 팔 퍼센트 내렸습니다."
    }
   ]
  },
  {
   "start": 6.704,
   "end": 12.436,
   "sents": [
    {
     "start": 6.704,
     "end": 12.436,
     "text": "실적 발표 다음 날, 나스닥은 그대로인데 주가는 십일 점 이 퍼센트 내렸습니다."
    }
   ]
  },
  {
   "start": 13.036,
   "end": 19.943,
   "sents": [
    {
     "start": 13.036,
     "end": 19.943,
     "text": "십일월 이십일 하루 하락은 나스닥이 빠진 만큼 평소 민감도 세 배로 함께 빠진 쪽이었습니다."
    }
   ]
  },
  {
   "start": 20.543,
   "end": 25.146,
   "sents": [
    {
     "start": 20.543,
     "end": 25.146,
     "text": "분기 매출은 일 년 전보다 백삼십팔 점 일 퍼센트 늘었습니다."
    }
   ]
  },
  {
   "start": 25.746,
   "end": 31.974,
   "sents": [
    {
     "start": 25.746,
     "end": 31.974,
     "text": "하루 십오 퍼센트 넘게 빠진 십오 번 가운데 일곱 번은, 이십 거래일 뒤 더 높았습니다."
    }
   ]
  },
  {
   "start": 32.574,
   "end": 36.366,
   "sents": [
    {
     "start": 32.574,
     "end": 36.366,
     "text": "십이월 이십일일 블룸 에너지 종가는 어디에 있을까요?"
    }
   ]
  },
  {
   "start": 36.966,
   "end": 41.723,
   "sents": [
    {
     "start": 36.966,
     "end": 41.723,
     "text": "사는 쪽과 사지 않는 쪽 근거는 아래 관련 영상에서 이어집니다."
    }
   ]
  }
 ]
}