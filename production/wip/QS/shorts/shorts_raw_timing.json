 "duration": 50.378,
 "paras": [
  {
   "start": 0.0,
   "end": 6.222,
   "sents": [
    {
     "start": 0.0,
     "end": 6.222,
     "text": "퀀텀스케이프는 십일월 십일일 일본 교토에서 새 전고체 셀 오스프리를 공개했습니다."
    }
   ]
  },
  {
   "start": 6.822,
   "end": 10.573,
   "sents": [
    {
     "start": 6.822,
     "end": 10.573,
     "text": "주가는 장 초반 오 점 육 퍼센트까지 올랐습니다."
    }
   ]
  },
  {
   "start": 11.173,
   "end": 14.999,
   "sents": [
    {
     "start": 11.173,
     "end": 14.999,
     "text": "그런데 그날 종가는 오 점 사 퍼센트 하락이었습니다."
    }
   ]
  },
  {
   "start": 15.599,
   "end": 19.994,
   "sents": [
    {
     "start": 15.599,
     "end": 19.994,
     "text": "같은 날 경쟁사 솔리드파워는 사 점 팔 퍼센트 올랐습니다."
    }
   ]
  },
  {
   "start": 20.594,
   "end": 27.207,
   "sents": [
    {
     "start": 20.594,
     "end": 27.207,
     "text": "다음 날 퀀텀스케이프는 칠 점 팔 퍼센트 더 빠져, 일 년 중 가장 낮은 종가를 썼습니다."
    }
   ]
  },
  {
   "start": 27.807,
   "end": 34.665,
   "sents": [
    {
     "start": 27.807,
     "end": 34.665,
     "text": "보도자료의 오 분 충전은 백서에서 섭씨 팔십 도 조건이었고, 고객 이름과 금액은 없었습니다."
    }
   ]
  },
  {
   "start": 35.265,
   "end": 42.183,
   "sents": [
    {
     "start": 35.265,
     "end": 42.183,
     "text": "과거 장중에 이렇게 반전한 십일 회 가운데, 한 달 뒤 그날 종가보다 높았던 것은 삼 회였습니다."
    }
   ]
  },
  {
   "start": 42.783,
   "end": 45.987,
   "sents": [
    {
     "start": 42.783,
     "end": 45.987,
     "text": "주가가 빠진 가장 큰 이유는 무엇이었을까요?"
    }
   ]
  },
  {
   "start": 46.587,
   "end": 49.778,
   "sents": [
    {
     "start": 46.587,
     "end": 49.778,
     "text": "풀영상은 아래 관련 영상에서 이어집니다."
    }
   ]
  }
 ]
}