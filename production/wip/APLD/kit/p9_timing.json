{
 "duration": 31.886,
 "paras": [
  {
   "start": 0.0,
   "end": 31.286,
   "sents": [
    {
     "start": 0.0,
     "end": 2.205,
     "text": "그리고 십일월 이십일입니다."
    },
    {
     "start": 2.205,
     "end": 6.625,
     "text": "어플라이드 디지털은 이날 하루에만 십칠 점 팔 퍼센트가 빠졌습니다."
    },
    {
     "start": 6.625,
     "end": 10.23,
     "text": "이날 이 회사 이름의 공시는 장이 끝난 뒤에야 나왔습니다."
    },
    {
     "start": 10.23,
     "end": 14.555,
     "text": "그것도 두 거래일 전 산 전환사채를 보고하는 서류였습니다."
    },
    {
     "start": 14.555,
     "end": 17.59,
     "text": "그럼 같은 날 다른 회사들은 어땠을까요?"
    },
    {
     "start": 17.59,
     "end": 21.12,
     "text": "나스닥 백 상장지수펀드가 오 점 칠 퍼센트 내렸습니다."
    },
    {
     "start": 21.12,
     "end": 26.575,
     "text": "같은 업종의 아이렌은 십팔 퍼센트, 네비우스는 십육 점 일 퍼센트 내렸습니다."
    },
    {
     "start": 26.575,
     "end": 31.286,
     "text": "어플라이드 디지털의 하락은 이 무리와 거의 같은 크기였습니다."
    }
   ]
  }
 ]
}