 "duration": 44.514,
 "paras": [
  {
   "start": 0.0,
   "end": 7.388,
   "sents": [
    {
     "start": 0.0,
     "end": 7.388,
     "text": "솔리드파워는 십일월 이십사일 일 점 삼이 달러로 마감해 일 년 최저를 다시 썼는데, 물타기 해도 될까요?"
    }
   ]
  },
  {
   "start": 7.988,
   "end": 17.037,
   "sents": [
    {
     "start": 7.988,
     "end": 17.037,
     "text": "같은 이 거래일 나스닥 대형주 펀드는 사 점 구 퍼센트 올랐는데, 솔리드파워는 시장을 따라가지 못하고 이 점 이 퍼센트 내렸습니다."
    }
   ]
  },
  {
   "start": 17.637,
   "end": 24.206,
   "sents": [
    {
     "start": 17.637,
     "end": 24.206,
     "text": "이번 최저 경신 구간은 십일 번째로, 첫 경신일보다 삼십이 점 삼 퍼센트 내려왔습니다."
    }
   ]
  },
  {
   "start": 24.806,
   "end": 33.417,
   "sents": [
    {
     "start": 24.806,
     "end": 33.417,
     "text": "과거 구간 십 개 가운데 아홉 번은 마지막 최저 뒤 육십 거래일째에 더 높았지만, 그 마지막은 지나고 나서야 알았습니다."
    }
   ]
  },
  {
   "start": 34.017,
   "end": 37.777,
   "sents": [
    {
     "start": 34.017,
     "end": 37.777,
     "text": "십이월 이십삼일 솔리드파워 종가는 어디에 있을까요?"
    }
   ]
  },
  {
   "start": 38.377,
   "end": 43.914,
   "sents": [
    {
     "start": 38.377,
     "end": 43.914,
     "text": "평균 단가를 낮출 쪽과 기다릴 쪽 근거는 아래 관련 영상에서 이어집니다."
    }
   ]
  }
 ]
}