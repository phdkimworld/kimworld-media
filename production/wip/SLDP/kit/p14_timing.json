   "start": 0.0,
   "end": 27.499,
   "sents": [
    {
     "start": 0.0,
     "end": 2.615,
     "text": "그럼 무엇을 보면 판단이 바뀔까요?"
    },
    {
     "start": 2.615,
     "end": 5.085,
     "text": "첫째는 십이월 십오일 종가입니다."
    },
    {
     "start": 5.085,
     "end": 7.55,
     "text": "둘째는 십이월 이십일일 종가입니다."
    },
    {
     "start": 7.55,
     "end": 12.76,
     "text": "이날 일 점 칠삼 달러 위로 돌아와 있으면, 사는 쪽 근거가 강해집니다."
    },
    {
     "start": 12.76,
     "end": 17.455,
     "text": "반대로 일 점 일칠 달러 아래면, 사지 않는 쪽 근거가 강해집니다."
    },
    {
     "start": 17.455,
     "end": 18.85,
     "text": "공시도 신호입니다."
    },
    {
     "start": 18.85,
     "end": 27.499,
     "text": "주식 판매 공시가 나오면 사지 않는 쪽, 금액이 붙은 합작법인 계약이나 새 생산 라인 시운전 소식은 사는 쪽에 무게를 보탭니다."
    }
   ]
  }
