 "paras": [
  {
   "start": 0.0,
   "end": 4.97,
   "sents": [
    {
     "start": 0.0,
     "end": 4.97,
     "text": "실스크는 십일월 십삼일 독일 전자 전시회에서 기조연설을 했습니다."
    }
   ]
  },
  {
   "start": 5.57,
   "end": 10.791,
   "sents": [
    {
     "start": 5.57,
     "end": 10.791,
     "text": "그런데 그날 주가는 오 점 삼 퍼센트 내려 일 점 이오 달러로 끝났습니다."
    }
   ]
  },
  {
   "start": 11.391,
   "end": 17.312,
   "sents": [
    {
     "start": 11.391,
     "end": 17.312,
     "text": "일주일 전 반등으로 얻은 상승분의 구십일 퍼센트를 네 거래일 만에 돌려줬습니다."
    }
   ]
  },
  {
   "start": 17.912,
   "end": 23.022,
   "sents": [
    {
     "start": 17.912,
     "end": 23.022,
     "text": "일주일 동안 보도자료는 여섯 건이었지만, 새 주문 금액은 없었습니다."
    }
   ]
  },
  {
   "start": 23.622,
   "end": 27.573,
   "sents": [
    {
     "start": 23.622,
     "end": 27.573,
     "text": "상장 뒤 반등을 이렇게 돌려준 때는 여섯 번 있었습니다."
    }
   ]
  },
  {
   "start": 28.173,
   "end": 32.741,
   "sents": [
    {
     "start": 28.173,
     "end": 32.741,
     "text": "여섯 번 모두 이십 거래일 안에 출발 저점 아래로 내려갔습니다."
    }
   ]
  },
  {
   "start": 33.341,
   "end": 37.395,
   "sents": [
    {
     "start": 33.341,
     "end": 37.395,
     "text": "그중 두 번은 다시 올라와 이십 거래일 뒤 더 높았습니다."
    }
   ]
  },
  {
   "start": 37.995,
   "end": 41.398,
   "sents": [
    {
     "start": 37.995,
     "end": 41.398,
     "text": "실스크 주가를 다시 붙잡을 계기는 무엇일까요?"
    }
   ]
  },
  {
   "start": 41.998,
   "end": 45.189,
   "sents": [
    {
     "start": 41.998,
     "end": 45.189,
     "text": "풀영상은 아래 관련 영상에서 이어집니다."
    }
   ]
  }
 ]
